# monitors 由 install-ceph.sh 按 ceph-nodes.conf 生成，勿手改 IP
# 刷新: bash install-ceph.sh csi-example
# 真实 userKey：sudo bash install-ceph.sh export-rbd → csi/generated/secret.yaml
apiVersion: v1
kind: Secret
metadata:
  name: csi-rbd-secret
  namespace: ceph-csi
stringData:
  userID: kubernetes
  userKey: "REPLACE_WITH_ceph_auth_get-key_client.kubernetes"
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: ceph-csi-config
  namespace: ceph-csi
data:
  config.json: |-
    [
      {
        "clusterID": "ceph",
        "monitors": [
          "172.16.10.131:6789",
          "172.16.10.132:6789",
          "172.16.10.133:6789"
        ]
      }
    ]
